          <a class="btn btn-secondary" href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener noreferrer">Read IEEE Publication (Doc 10627276)</a>
          <a class="btn btn-secondary" href="#contact">Download 1-Page Resume</a>
        </div>
      </div>
    </section>

