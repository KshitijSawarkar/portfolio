  <script>
    // 1 — clock (IST)
    const clockEl = document.getElementById('clock');
    function tickClock() {
      try {
        const t = new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour12: false });
        if (clockEl) clockEl.textContent = t + ' IST';
      } catch {}
    }
    tickClock(); setInterval(tickClock, 1000);

    // 2 — hero typer
    const phrases = [
      'ros2 bringup… MentorPi M1 localized. 2D LiDAR SLAM online.',
      'forward deployed… Wakefit NPL plant-floor schema engine sub-50ms.',
      'SDR spectral pipeline… 2.4/5.8GHz UAV RF bursts intercepted.',
      'edge perception… INT8 YOLOv5 on ARM with <1% mAP degradation.',
      'control systems… dynamic multivariable state-space feedback nominal.'
    ];
    const typer = document.getElementById('typer');
    let pi = 0, ci = 0, del = false;
    function typeLoop() {
      if (!typer) return;
      const p = phrases[pi];
      typer.textContent = p.slice(0, ci);
      if (!del) { ci++; if (ci > p.length + 14) del = true; }
      else { ci -= 2; if (ci <= 0) { ci = 0; del = false; pi = (pi + 1) % phrases.length; } }
      setTimeout(typeLoop, del ? 28 : 52);
    }
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) typeLoop(); else if (typer) typer.textContent = phrases[0];

    // 3 — terminal typer
    const termEl = document.getElementById('term-type');
    const termMsg = 'uplink --establish --target field-commissioning';
    let ti = 0;
    function termLoop() {
      if (!termEl) return;
      termEl.textContent = termMsg.slice(0, ti++);
      if (ti <= termMsg.length + 30) setTimeout(termLoop, ti <= termMsg.length ? 55 : 120);
    }
    if (!reduceMotion) {
      const io0 = new IntersectionObserver((e) => {
        if (e[0].isIntersecting) { termLoop(); io0.disconnect(); }
      }, { threshold: 0.4 });
      const term = document.querySelector('.terminal');
      if (term) io0.observe(term);
    } else if (termEl) termEl.textContent = termMsg;

    // 4 — scroll reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // 5 — animated counters
    const cio = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const el = en.target; cio.unobserve(el);
        const target = parseInt(el.dataset.count || '0', 10);
        if (reduceMotion) { el.textContent = String(target); return; }
        const t0 = performance.now(), dur = 1200;
        (function step(t) {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(step);
        })(t0);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

    // 6 — card spotlight follows cursor
    document.querySelectorAll('.card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
        card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
      });
    });

    // 7 — lidar radar canvas
    (function () {
      const cv = document.getElementById('lidar');
      if (!cv || reduceMotion) return;
      const ctx = cv.getContext('2d');
      let w, h, t = 0, pts = [];
      function size() {
        const r = cv.parentElement.getBoundingClientRect();
        w = cv.width = r.width; h = cv.height = r.height;
        pts = Array.from({ length: 70 }, () => ({
          x: Math.random() * w, y: Math.random() * h,
          r: Math.random() * 1.8 + 0.4, s: Math.random() * 0.4 + 0.1
        }));
      }
      size(); window.addEventListener('resize', size);
      const cx = () => w * 0.78, cy = () => h * 0.42;
      (function draw() {
        t += 0.012;
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = 'rgba(148,184,255,0.35)';
        pts.forEach((p) => { p.y -= p.s; if (p.y < 0) p.y = h; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 7); ctx.fill(); });
        const R = Math.min(w, h) * 0.32;
        for (let i = 1; i <= 3; i++) {
          ctx.beginPath(); ctx.arc(cx(), cy(), (R / 3) * i, 0, 7);
          ctx.strokeStyle = 'rgba(61,255,143,0.16)'; ctx.lineWidth = 1; ctx.stroke();
        }
        ctx.save();
        ctx.translate(cx(), cy()); ctx.rotate(t);
        const g = ctx.createLinearGradient(0, 0, R, 0);
        g.addColorStop(0, 'rgba(61,255,143,0.5)'); g.addColorStop(1, 'rgba(61,255,143,0)');
        ctx.strokeStyle = g; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(R, 0); ctx.stroke();
        ctx.restore();
        const blips = [[0.5, 1.2], [1.9, 2.6], [3.4, 0.6], [4.4, 2.0]];
        blips.forEach(([a, rr]) => {
          const d = ((t * 1.2 + a) % (Math.PI * 2));
          const alpha = Math.max(0, 1 - d / 4);
          const bx = cx() + Math.cos(a) * (R / 3) * rr * 0.55, by = cy() + Math.sin(a) * (R / 3) * rr * 0.55;
          ctx.beginPath(); ctx.arc(bx, by, 3, 0, 7);
          ctx.fillStyle = `rgba(65,230,255,${(alpha * 0.9).toFixed(2)})`;
          ctx.shadowColor = '#41e6ff'; ctx.shadowBlur = 12 * alpha; ctx.fill(); ctx.shadowBlur = 0;
        });
        requestAnimationFrame(draw);
      })();
    })();

    // 8b — quantization bars animate on scroll
    (function () {
      const fills = document.querySelectorAll('.q-fill');
      if (!fills.length) return;
      const qio = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          qio.unobserve(en.target);
          requestAnimationFrame(() => { en.target.style.width = (en.target.getAttribute('data-w') || '100') + '%'; });
        });
      }, { threshold: 0.5 });
      fills.forEach((f) => qio.observe(f));
    })();

    // 8c — neural network canvas
    (function () {
      const cv = document.getElementById('neural');
      if (!cv || reduceMotion) return;
      const ctx = cv.getContext('2d');
      let w, h, nodes = [], pulses = [];
      const COLORS = ['65,230,255', '167,139,250', '61,255,143'];
      function size() {
        const r = cv.parentElement.getBoundingClientRect();
        w = cv.width = r.width; h = cv.height = r.height;
        const layers = [5, 8, 8, 5];
        nodes = [];
        layers.forEach((count, li) => {
          for (let n = 0; n < count; n++) {
            nodes.push({
              bx: w * (0.12 + (0.76 * li) / (layers.length - 1)),
              by: h * ((n + 1) / (count + 1)),
              x: 0, y: 0, li,
              ph: Math.random() * 6.28,
              sp: 0.004 + Math.random() * 0.008,
              r: 2.2 + Math.random() * 1.6,
              c: COLORS[li % 3]
            });
          }
        });
        nodes.forEach((nd) => { nd.x = nd.bx; nd.y = nd.by; });
      }
      size(); window.addEventListener('resize', size);
      let tick = 0;
      function spawn() {
        const left = nodes.filter((n) => n.li === 0);
        const a = left[Math.floor(Math.random() * left.length)];
        if (a) pulses.push({ n: a, t: 0 });
      }
      setInterval(() => { if (document.visibilityState === 'visible' && Math.random() < 0.7) spawn(); }, 500);
      (function draw() {
        tick += 0.016;
        ctx.clearRect(0, 0, w, h);
        nodes.forEach((nd) => {
          nd.x = nd.bx + Math.sin(tick * nd.sp * 60 + nd.ph) * 7;
          nd.y = nd.by + Math.cos(tick * nd.sp * 50 + nd.ph) * 9;
        });
        nodes.forEach((a) => {
          nodes.forEach((b) => {
            if (b.li !== a.li + 1) return;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(${a.c},0.13)`; ctx.lineWidth = 1; ctx.stroke();
          });
        });
        pulses = pulses.filter((p) => p.t <= 1.6);
        pulses.forEach((p) => {
          p.t += 0.03;
          const li = Math.min(2, Math.floor(p.t));
          const k = p.t - li;
          const A = nodes.filter((n) => n.li === li);
          const B = nodes.filter((n) => n.li === li + 1);
          if (!A.length || !B.length) return;
          const a = A[Math.floor((p.t * 13) % A.length)], b = B[Math.floor((p.t * 7) % B.length)];
          const x = a.x + (b.x - a.x) * Math.min(1, k), y = a.y + (b.y - a.y) * Math.min(1, k);
          ctx.beginPath(); ctx.arc(x, y, 3, 0, 7);
          ctx.fillStyle = 'rgba(61,255,143,0.95)'; ctx.shadowColor = '#3dff8f'; ctx.shadowBlur = 14; ctx.fill(); ctx.shadowBlur = 0;
        });
        nodes.forEach((nd) => {
          ctx.beginPath(); ctx.arc(nd.x, nd.y, nd.r, 0, 7);
          ctx.fillStyle = `rgba(${nd.c},0.85)`; ctx.shadowColor = `rgb(${nd.c})`; ctx.shadowBlur = 10; ctx.fill(); ctx.shadowBlur = 0;
        });
        requestAnimationFrame(draw);
      })();
    })();

    // 8d — per-section fx engine
    function fx(id, setup) {
      const cv = document.getElementById(id);
      if (!cv || reduceMotion) return;
      const ctx = cv.getContext('2d');
      let w = 0, h = 0, visible = false;
      const S = setup() || {};
      const size = () => {
        const r = cv.parentElement.getBoundingClientRect();
        w = cv.width = Math.max(1, r.width); h = cv.height = Math.max(1, r.height);
        if (S.resize) S.resize(w, h);
      };
      size(); window.addEventListener('resize', size);
      new IntersectionObserver((e) => { visible = e[0].isIntersecting; }, { threshold: 0 }).observe(cv);
      if (S.frame0) S.frame0(ctx, w, h);
      (function loop() {
        requestAnimationFrame(loop);
        if (!visible || document.visibilityState !== 'visible') return;
        ctx.clearRect(0, 0, w, h);
        S.draw(ctx, w, h);
      })();
    }

    // PILLARS — telemetry waveforms
    fx('fx-pillars', () => {
      let t = 0;
      const traces = [
        { c: '61,255,143', amp: 26, fr: 0.012, sp: 0.03, y: 0.3 },
        { c: '65,230,255', amp: 38, fr: 0.008, sp: 0.02, y: 0.55 },
        { c: '167,139,250', amp: 20, fr: 0.017, sp: 0.042, y: 0.78 }
      ];
      return {
        draw(ctx, w, h) {
          t += 1;
          traces.forEach((tr) => {
            ctx.beginPath();
            for (let x = 0; x <= w; x += 6) {
              const y = h * tr.y + Math.sin(x * tr.fr + t * tr.sp) * tr.amp * Math.sin(x * 0.002 + t * 0.008);
              x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            }
            ctx.strokeStyle = `rgba(${tr.c},0.35)`; ctx.lineWidth = 1.5; ctx.stroke();
          });
        }
      };
    });

    // VAULT — binary data rain
    fx('fx-vault', () => {
      let cols = [];
      const resize = (w, h) => {
        const n = Math.floor(w / 26);
        cols = Array.from({ length: n }, () => ({ y: Math.random() * h, sp: 1 + Math.random() * 2.2 }));
      };
      return {
        resize,
        draw(ctx, w, h) {
          ctx.font = '13px JetBrains Mono, monospace';
          cols.forEach((c, i) => {
            const x = i * 26 + 8;
            ctx.fillStyle = 'rgba(61,255,143,0.28)';
            ctx.fillText(Math.random() < 0.5 ? '1' : '0', x, c.y);
            ctx.fillStyle = 'rgba(65,230,255,0.14)';
            ctx.fillText(Math.random() < 0.5 ? '1' : '0', x, c.y - 20);
            c.y += c.sp;
            if (c.y > h + 20) { c.y = -20; c.sp = 1 + Math.random() * 2.2; }
          });
        }
      };
    });

    // RESEARCH — orbital electronics
    fx('fx-research', () => {
      let t = 0;
      return {
        draw(ctx, w, h) {
          t += 0.012;
          const hubs = [
            { x: w * 0.86, y: h * 0.28, r: 46, c: '65,230,255' },
            { x: w * 0.08, y: h * 0.72, r: 60, c: '255,178,36' }
          ];
          hubs.forEach((hb, hi) => {
            ctx.beginPath(); ctx.arc(hb.x, hb.y, 3.5, 0, 7);
            ctx.fillStyle = `rgba(${hb.c},0.9)`; ctx.fill();
            for (let o = 0; o < 2; o++) {
              const rx = hb.r + o * 26, ry = rx * 0.45, rot = hi * 0.7 + o * 0.5;
              ctx.beginPath(); ctx.ellipse(hb.x, hb.y, rx, ry, rot, 0, 7);
              ctx.strokeStyle = `rgba(${hb.c},0.22)`; ctx.lineWidth = 1; ctx.stroke();
              for (let e = 0; e < 2; e++) {
                const a = t * (1 + o * 0.4) + e * 3.14 + hi;
                const ex = hb.x + Math.cos(a) * rx * Math.cos(rot) - Math.sin(a) * ry * Math.sin(rot);
                const ey = hb.y + Math.cos(a) * rx * Math.sin(rot) + Math.sin(a) * ry * Math.cos(rot);
                ctx.beginPath(); ctx.arc(ex, ey, 2.6, 0, 7);
                ctx.fillStyle = `rgba(${hb.c},0.85)`; ctx.fill();
              }
            }
          });
        }
      };
    });

    // TRAJECTORY — forward stream
    fx('fx-trajectory', () => {
      let parts = [];
      const resize = (w, h) => {
        parts = Array.from({ length: 46 }, () => ({
          x: Math.random() * w, y: Math.random() * h,
          s: 0.6 + Math.random() * 2.2, r: 1 + Math.random() * 1.8
        }));
      };
      return {
        resize,
        draw(ctx, w, h) {
          parts.forEach((p) => {
            p.x += p.s;
            if (p.x > w + 10) { p.x = -10; p.y = Math.random() * h; }
            const tail = 26 * p.s;
            const g = ctx.createLinearGradient(p.x - tail, p.y, p.x, p.y);
            g.addColorStop(0, 'rgba(61,255,143,0)');
            g.addColorStop(1, 'rgba(61,255,143,0.5)');
            ctx.strokeStyle = g; ctx.lineWidth = p.r;
            ctx.beginPath(); ctx.moveTo(p.x - tail, p.y); ctx.lineTo(p.x, p.y); ctx.stroke();
          });
        }
      };
    });

    // AGENTS — constellation mesh
    fx('fx-agents', () => {
      let pts = [];
      const resize = (w, h) => {
        pts = Array.from({ length: 34 }, () => ({
          x: Math.random() * w, y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4
        }));
      };
      return {
        resize,
        draw(ctx, w, h) {
          pts.forEach((p) => {
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0 || p.x > w) p.vx *= -1;
            if (p.y < 0 || p.y > h) p.vy *= -1;
          });
          for (let i = 0; i < pts.length; i++) {
            for (let j = i + 1; j < pts.length; j++) {
              const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
              const d = Math.hypot(dx, dy);
              if (d < 130) {
                ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(167,139,250,${(0.28 * (1 - d / 130)).toFixed(3)})`;
                ctx.lineWidth = 1; ctx.stroke();
              }
            }
          }
          pts.forEach((p) => {
            ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, 7);
            ctx.fillStyle = 'rgba(167,139,250,0.8)'; ctx.fill();
          });
        }
      };
    });

    // CONTACT — uplink beacon
    fx('fx-contact', () => {
      let rings = [], sparks = [], t = 0;
      return {
        draw(ctx, w, h) {
          t += 1;
          const ox = w / 2, oy = h + 10;
          if (t % 46 === 0) rings.push({ r: 10, a: 0.5 });
          rings = rings.filter((rg) => rg.a > 0.02);
          rings.forEach((rg) => {
            rg.r += 2.4; rg.a *= 0.985;
            ctx.beginPath(); ctx.arc(ox, oy, rg.r, Math.PI, 2 * Math.PI);
            ctx.strokeStyle = `rgba(61,255,143,${rg.a.toFixed(3)})`; ctx.lineWidth = 1.5; ctx.stroke();
          });
          if (t % 8 === 0 && sparks.length < 60) {
            sparks.push({ x: ox + (Math.random() - 0.5) * 120, y: h - 6, s: 0.8 + Math.random() * 1.6 });
          }
          sparks = sparks.filter((sp) => sp.y > -10);
          sparks.forEach((sp) => {
            sp.y -= sp.s; sp.x += Math.sin(sp.y * 0.03) * 0.4;
            ctx.beginPath(); ctx.arc(sp.x, sp.y, 1.6, 0, 7);
            ctx.fillStyle = 'rgba(65,230,255,0.6)'; ctx.fill();
          });
        }
      };
    });

    // 8 — rotating telemetry line
    (function () {
      const el = document.getElementById('tele-text');
      if (!el || reduceMotion) return;
      const msgs = [
        'SYS.ONLINE — Wakefit NPL Ops · MNNIT M.Tech',
        'AMR LOCALIZED — ROS2 MentorPi M1 · 2D LiDAR SLAM',
        'UAV RF SENSING 2.4/5.8 GHz · SDR pipeline active',
        'EDGE PERCEPTION INT8 · <1% mAP loss · IEEE 10627276',
        'FDE SCHEMA RUNTIME 41ms · 0 drift · plant-floor ready'
      ];
      let i = 0;
      setInterval(() => { i = (i + 1) % msgs.length; el.textContent = msgs[i]; }, 3200);
    })();

    // 8e2 — day/night theme toggle
    (function () {
      const btn = document.getElementById('theme-btn');
      const icon = document.getElementById('theme-icon');
      const meta = document.querySelector('meta[name="theme-color"]');
      function paint() {
        const light = document.documentElement.getAttribute('data-theme') === 'light';
        if (icon) icon.textContent = light ? '☀' : '☾';
        if (btn) {
          btn.setAttribute('aria-pressed', String(light));
          btn.setAttribute('aria-label', light ? 'Switch to night mode' : 'Switch to day mode');
        }
        if (meta) meta.setAttribute('content', light ? '#edf1f7' : '#05070d');
      }
      paint();
      if (btn) btn.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('ks-theme', next); } catch {}
        paint();
      });
    })();

    // 8e3 — projects dashboard (auto-rotating carousel with 6 items)
    (function () {
      const dash = document.getElementById('dash');
      const track = document.getElementById('dash-track');
      const view = document.getElementById('dash-view');
      const cur = document.getElementById('dash-cur');
      const nameEl = document.getElementById('dash-name');
      const bar = document.getElementById('dash-bar');
      if (!dash || !track || !view || !cur || !nameEl || !bar) return;
      const thumbs = Array.from(document.querySelectorAll('.dash-thumb'));
      const names = [
        'MentorPi M1 AMR (ROS2)',
        'BOM Schema Engine (FDE)',
        'Drone RF Classification',
        'Edge Vision (IEEE 10627276)',
        'Sensorless Solar Tracker',
        'Plant Ingestion Utility'
      ];
      const N = names.length, DUR = 6000;
      let idx = 0, timer = null, inView = false;
      function paintBar() {
        if (reduceMotion) return;
        bar.style.transition = 'none'; bar.style.width = '0%';
        void bar.offsetWidth;
        bar.style.transition = `width ${DUR}ms linear`; bar.style.width = '100%';
      }
      function show(i, manual) {
        idx = ((i % N) + N) % N;
        track.style.transform = `translateX(-${idx * 100}%)`;
        cur.textContent = String(idx + 1).padStart(2, '0');
        nameEl.textContent = names[idx];
        thumbs.forEach((t, ti) => t.setAttribute('aria-current', String(ti === idx)));
        if (manual) restart();
        else paintBar();
      }
      function restart() {
        stop();
        if (reduceMotion || !inView || document.hidden) { paintBar(); return; }
        paintBar();
        timer = setInterval(() => show(idx + 1, false), DUR);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function freezeBar() {
        stop();
        if (reduceMotion) return;
        const w = getComputedStyle(bar).width;
        bar.style.transition = 'none'; bar.style.width = w;
      }
      document.getElementById('dash-prev').addEventListener('click', () => show(idx - 1, true));
      document.getElementById('dash-next').addEventListener('click', () => show(idx + 1, true));
      thumbs.forEach((t) => t.addEventListener('click', () => show(parseInt(t.dataset.i || '0', 10), true)));
      view.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(idx - 1, true); }
        if (e.key === 'ArrowRight') { e.preventDefault(); show(idx + 1, true); }
      });
      let sx = null;
      view.addEventListener('pointerdown', (e) => { sx = e.clientX; });
      view.addEventListener('pointerup', (e) => {
        if (sx === null) return;
        const dx = e.clientX - sx; sx = null;
        if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1), true);
      });
      dash.addEventListener('pointerenter', freezeBar);
      dash.addEventListener('pointerleave', restart);
      dash.addEventListener('focusin', freezeBar);
      dash.addEventListener('focusout', restart);
      document.addEventListener('visibilitychange', () => { document.hidden ? freezeBar() : restart(); });
      new IntersectionObserver((e) => { inView = e[0].isIntersecting; inView ? restart() : stop(); }, { threshold: 0.15 }).observe(dash);
    })();

    // 9 — copy buttons
    (function () {
      const status = document.getElementById('copy-status');
      async function copyText(text, btn) {
        let ok = false;
        try { await navigator.clipboard.writeText(text); ok = true; }
        catch {
          const ta = document.createElement('textarea');
          ta.value = text; document.body.appendChild(ta); ta.select();
          try { ok = document.execCommand('copy'); } catch {}
          ta.remove();
        }
        if (btn) {
          const orig = btn.textContent;
          btn.textContent = ok ? 'Copied ✓' : 'Copy failed';
          btn.classList.toggle('ok', ok);
          setTimeout(() => { btn.textContent = orig; btn.classList.remove('ok'); }, 1800);
        }
        if (status) status.textContent = ok ? '✓ copied to clipboard' : '';
        return ok;
      }
      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rel = btn.getAttribute('data-copy') || '';
          copyText(new URL(rel, window.location.href).href, btn);
        });
      });
      document.querySelectorAll('[data-copy-target]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = document.getElementById(btn.getAttribute('data-copy-target') || '');
          if (src) copyText(src.innerText, btn);
        });
      });
    })();

    // 10 — site agent (grounded in latest facts from /llms.txt)
    (function () {
      const log = document.getElementById('agent-log');
      const form = document.getElementById('agent-form');
      const input = document.getElementById('agent-input');
      if (!log || !form || !input) return;
      const KB = [
        { k: ['ieee', 'paper', 'publish', 'research', 'yolo', 'quantiz', 'edge vision', 'retail', 'smart cart'], a: 'Lead Author on <b>IEEE Xplore Doc ID: 10627276</b> (<i>Automated Object Detection and Billing Architecture for Smart Retail Systems</i>): INT8 post-training quantization on ARM Raspberry Pi with &lt;1% mAP degradation and sub-second inference. <a href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener">Verify on IEEE ↗</a>' },
        { k: ['wakefit', 'npl', 'schema', 'bom', 'work', 'job', 'intern'], a: '<b>Wakefit Innovations Ltd.</b> (Aug 2026 – Present, Bengaluru / Hosur): Systems Automation Intern (PGET). Built <a href="https://npl-automation.pages.dev/" target="_blank" rel="noopener">npl-automation.pages.dev</a> on Cloudflare Pages, compressing 72+ operational hours into deterministic sub-minute runs with &lt;50ms latency.' },
        { k: ['drone', 'rf', 'sdr', 'spectrogram', 'uav', 'telemetry', 'signal', 'radio'], a: '<b>Real-Time Drone Detection &amp; RF Classification:</b> Automated edge spectral sensing pipeline intercepting UAV flight controller communications across 2.4 GHz &amp; 5.8 GHz ISM bands via SDR, FFT spectrograms, and lightweight neural classification. <a href="https://docs.google.com/presentation/d/1IMEy7h-iVUmmVrr2GoM_qS5AJWuqM7LC51hbWQ7Y5Rg/edit?usp=sharing" target="_blank" rel="noopener">Presentation ↗</a>' },
        { k: ['robot', 'ros', 'slam', 'amr', 'mentorpi', 'embedded', 'hardware', 'solar', 'tracker', 'gas', 'wokwi'], a: '<b>Robotics &amp; Embedded:</b> HiWonder MentorPi M1 on ROS2 + Pi 5 (<a href="https://drive.google.com/file/d/1OSRXNmmUL0gwdElcF-1Ftl1Xcxfa-7rT/view?usp=sharing" target="_blank" rel="noopener">Inspection ↗</a>) · Sensorless solar tracking using PV panel voltage directly · Gas hazard detection on Arduino + MQ-2 (<a href="https://wokwi.com/projects/453321379118788609" target="_blank" rel="noopener">Wokwi ↗</a>).' },
        { k: ['trendguard', 'quant', 'trading', 'risk', 'finance'], a: '<b>TrendGuard-200:</b> Quantitative signal generation engine in Python (NumPy/Pandas) across 8-year OHLC data, achieving a 72.7% win rate with dynamic position sizing and moving averages (21, 50, 200 SMA).' },
        { k: ['live', 'production', 'system', 'deploy', 'vault', 'project', 'cardsfinder', 'asset', 'renamer'], a: 'Nine verified engineering systems across <b>02 // Deployments</b>: BOM schema engine (&lt;50ms) · Drone RF SDR pipeline · MentorPi M1 AMR · CardsFinders · Asset renamer · Smart shopping cart (IEEE) · TrendGuard-200 · Sensorless solar tracker · Gas safety detector.' },
        { k: ['educat', 'mtech', 'mnnit', 'degree', 'college', 'btech', 'rcoem'], a: '<b>M.Tech in Control and Instrumentation</b> from MNNIT Allahabad (2025–Present) &amp; Graduate Teaching Assistant · <b>B.Tech in ECE</b> from RCOEM Nagpur (2020–2024).' },
        { k: ['contact', 'email', 'phone', 'hire', 'commission', 'deploy', 'reach', 'linkedin', 'github'], a: 'Based in <b>Bengaluru / Hosur, India</b> · Available for on-site engineering sprints · Email: <b>kshitijsawarkar333@gmail.com</b> · Phone: <b>+91-9823252972</b> · <a href="https://www.linkedin.com/in/kshitijas/" target="_blank" rel="noopener">LinkedIn ↗</a> · <a href="https://github.com/KshitijSawarkar" target="_blank" rel="noopener">GitHub ↗</a>.' },
        { k: ['stack', 'tech', 'skill', 'competencies'], a: '<b>4 Technical Domains:</b> 1. Autonomous Robotics &amp; Embedded (ROS2, CAN, UART, SPI, I2C, HIL) · 2. Applied AI &amp; Edge Perception (YOLOv5 INT8, OpenCV) · 3. RF Telemetry &amp; Signal Processing (SDR, FFT spectrograms) · 4. Production Systems &amp; Cloud (Cloudflare Pages, AWS SageMaker/Lambda).' },
        { k: ['agent', 'llm', 'mcp', 'rag', 'prompt', 'api', 'json', 'ground'], a: 'This site is agent-native: <b>GET /llms.txt</b> for plain-text ground truth, <b>GET /api/profile.json</b> for typed JSON data, plus the copy-paste <b>Prompt Pack</b> above.' },
        { k: ['who', 'about', 'kshitij', 'summary', 'introduce'], a: '<b>Kshitij Ashok Sawarkar</b> — Autonomous Robotics, Embedded Systems &amp; Forward Deployed Engineering. M.Tech Control &amp; Instrumentation (MNNIT) · B.Tech ECE (RCOEM) · Lead author IEEE Xplore 10627276 · Wakefit NPL automation.' },
        { k: ['hi', 'hello', 'hey', 'namaste'], a: 'Uplink established. Ask about the <b>IEEE paper</b>, <b>Wakefit NPL</b>, <b>Drone RF SDR</b>, <b>MentorPi ROS2</b>, or <b>contact</b>.' }
      ];
      const FALLBACK = 'Grounded answer unavailable for that query — I only answer from <b>/llms.txt</b>. Try: <b>IEEE paper?</b> · <b>Wakefit NPL?</b> · <b>Drone RF SDR?</b> · <b>Robotics &amp; ROS2?</b> · <b>Contact?</b>';
      function addMsg(html, who) {
        const d = document.createElement('div');
        d.className = 'agent-msg ' + who;
        d.innerHTML = html;
        log.appendChild(d);
        log.scrollTop = log.scrollHeight;
        return d;
      }
      function answer(q) {
        const s = q.toLowerCase();
        for (const item of KB) if (item.k.some((k) => s.includes(k))) return item.a;
        return FALLBACK;
      }
      let greeted = false;
      function greet() {
        if (greeted) return; greeted = true;
        addMsg('Link established. I answer strictly from this site\u2019s ground truth (<b>/llms.txt</b> + <b>/api/profile.json</b>). Ask anything about Kshitij\u2019s systems, research, or experience.', 'bot');
      }
      const gio = new IntersectionObserver((e) => { if (e[0].isIntersecting) { greet(); gio.disconnect(); } }, { threshold: 0.3 });
      gio.observe(log);
      function ask(q) {
        const query = q.trim();
        if (!query) return;
        greet();
        addMsg(query.replace(/</g, '&lt;'), 'user');
        input.value = '';
        if (reduceMotion) { addMsg(answer(query), 'bot'); return; }
        const t = document.createElement('div');
        t.className = 'agent-msg bot typing';
        t.innerHTML = '<i></i><i></i><i></i>';
        log.appendChild(t);
        log.scrollTop = log.scrollHeight;
        setTimeout(() => { t.remove(); addMsg(answer(query), 'bot'); }, 550 + Math.random() * 400);
      }
      form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
      document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => ask(b.getAttribute('data-ask') || '')));
    })();
  </script>
</Layout>
