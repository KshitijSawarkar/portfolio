---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <!-- HEADER -->
  <header class="site-header">
    <div class="wrap">
      <div class="header-row">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <a class="brand" href="#top" translate="no"><span class="sig">KS</span>kshitij.sawarkar <small>// forward-deployed</small></a>
          <span class="telemetry"><span class="dot" aria-hidden="true"></span><span id="tele-text">SYS.ONLINE — Wakefit NPL Ops · MNNIT M.Tech</span></span>
        </div>
        <nav class="nav" aria-label="Primary">
          <a href="#pillars">01 Systems</a>
          <a href="#vault">02 Vault</a>
          <a href="#research">03 Research</a>
          <a href="#trajectory">04 Trajectory</a>
          <a href="#agents">05 Agents</a>
          <a href="#contact">06 Contact</a>
          <span class="clock" id="clock" aria-hidden="true">--:--:-- IST</span>
        </nav>
      </div>
      <div class="machine-strip"><span><b>▸ AI CONTEXT</b> GET <a href={`${base}llms.txt`}>/llms.txt</a> · GET <a href={`${base}api/profile.json`}>/api/profile.json</a></span><span style="margin-left:auto" id="build-tag">BUILD STABLE · EDGE-READY</span></div>
    </div>
  </header>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-inner" id="ticker">
      <span><b>● LIVE</b> SUB-50MS SCHEMA ENGINE — NPL BOMMASANDRA</span><span>INT8 YOLOv5 · &lt;1% mAP LOSS · IEEE 10627276</span><span><b>● ROS2</b> MENTORPI M1 · SLAM · HIL SAFETY INTERLOCKS</span><span>&gt;80% ASSET LATENCY CUT · ZERO SERVER COST</span><span><b>● OPEN</b> FOR ON-SITE APAC COMMISSIONING SPRINTS</span>
      <span><b>● LIVE</b> SUB-50MS SCHEMA ENGINE — NPL BOMMASANDRA</span><span>INT8 YOLOv5 · &lt;1% mAP LOSS · IEEE 10627276</span><span><b>● ROS2</b> MENTORPI M1 · SLAM · HIL SAFETY INTERLOCKS</span><span>&gt;80% ASSET LATENCY CUT · ZERO SERVER COST</span><span><b>● OPEN</b> FOR ON-SITE APAC COMMISSIONING SPRINTS</span>
    </div>
  </div>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <canvas id="lidar" aria-hidden="true"></canvas>
      <div class="float-orb" style="width:340px;height:340px;left:-80px;top:10%;background:#123f2c"></div>
      <div class="float-orb" style="width:280px;height:280px;right:-60px;top:40%;background:#0e2a3f;animation-delay:-6s"></div>
      <div class="wrap" style="width:100%">
        <p class="eyebrow rv">Forward Deployed · Edge Vision · Floor Automation</p>
        <h1 class="rv rv-d1" style="margin-top:14px">Kshitij Ashok<br /><span class="grad">Sawarkar</span><span class="role">Forward Deployed Systems &amp; Robotics Engineer — M.Tech Control &amp; Instrumentation, MNNIT Allahabad</span></h1>
        <p class="type-line rv rv-d2" aria-live="polite"><span>&gt; </span><span id="typer"></span><span class="caret" aria-hidden="true"></span></p>
        <p class="meta rv rv-d2" style="margin-top:6px">BENGALURU, IN — AVAILABLE FOR ON-SITE REGIONAL &amp; APAC FIELD DEPLOYMENTS</p>
        <div class="manifesto rv rv-d2">
          Operating at the physical boundary where AMRs, edge vision pipelines, and production lines collide. I turn floor friction into sub-50ms deterministic schema engines, INT8-quantized edge neural nets, and robust ROS2 controllers. IEEE Xplore lead author (Doc 10627276) — focused on zero-downtime commissioning and closed-loop stability.
        </div>
        <p class="coords rv rv-d3">kshitijsawarkar333@gmail.com · +91-9823252972 · <a href="https://linkedin.com/in/kshitijas">linkedin.com/in/kshitijas</a> · <a href="https://github.com/KshitijSawarkar">github.com/KshitijSawarkar</a></p>
        <div class="cta-row rv rv-d3">
          <a class="btn btn-primary" href="#vault">Explore live systems ↓</a>
          <a class="btn btn-secondary" href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener noreferrer">IEEE paper 10627276 ↗</a>
          <a class="btn btn-secondary" href="#contact">Establish link</a>
        </div>
        <div class="stats rv rv-d3">
          <div class="stat"><div class="num"><em>&lt;</em><span data-count="50">0</span>ms</div><div class="lbl">Schema exec latency</div></div>
          <div class="stat"><div class="num"><em>&lt;</em><span data-count="1">0</span>%</div><div class="lbl">mAP loss after INT8</div></div>
          <div class="stat"><div class="num"><em>&gt;</em><span data-count="80">0</span>%</div><div class="lbl">Asset latency cut</div></div>
          <div class="stat"><div class="num">10627276</div><div class="lbl">IEEE Xplore doc ID</div></div>
        </div>
        <div class="chips rv rv-d3">
          <span class="chip">ROS2</span><span class="chip">Raspberry Pi 5</span><span class="chip">YOLOv5 INT8</span><span class="chip">ONNX Runtime</span><span class="chip">TypeScript</span><span class="chip">Cloudflare Edge</span><span class="chip">MATLAB / Simulink</span><span class="chip">ESP32 · CAN · I2C</span>
        </div>
      </div>
    </section>

    <!-- PILLARS -->
    <section class="section" id="pillars">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">01 // FDE Systems Pillars</p>
          <span class="sec-index">SYS.PILLARS — 04 ACTIVE</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Systems that survive the floor.</h2>
        <p class="rv rv-d1" style="max-width:62ch">Not demos — commissionable stacks. Each pillar maps to hardware I've touched, models I've quantized, or lines I've kept running.</p>
        <div class="grid-2" style="margin-top:28px">
          <div class="card rv"><p class="pillar-no">PILLAR 01</p><h3>Field Commissioning &amp; Mobile Robotics</h3>
            <p>ROS2 · Embedded Linux (Pi 5) · AMRs/AGVs · HIL testing · sensor fusion · CAN/UART/I2C · ESP32 &amp; ARM.</p>
            <p class="stack"><strong>Scope:</strong> site acceptance testing, floor-map calibration, obstacle-avoidance triage, sensor-to-middleware integration.</p></div>
          <div class="card rv rv-d1"><p class="pillar-no">PILLAR 02</p><h3>Edge AI &amp; Low-Latency Vision</h3>
            <p>YOLOv5 · OpenCV · INT8 post-training quantization · ONNX Runtime · ARM edge acceleration.</p>
            <p class="stack"><strong>Scope:</strong> quantized detection on edge nodes with no cloud dependency — sub-second inference, no discrete GPU.</p></div>
          <div class="card rv"><p class="pillar-no">PILLAR 03</p><h3>Customer Systems &amp; Floor Integration</h3>
            <p>Deterministic schema engines · sub-50ms in-browser validation · Pydantic v2 guardrails · REST · Cloudflare Pages/Workers · TypeScript · FastAPI.</p>
            <p class="stack"><strong>Scope:</strong> kill spreadsheet friction, catalog-ingestion latency, and client-side data leaks.</p></div>
          <div class="card rv rv-d1"><p class="pillar-no">PILLAR 04</p><h3>Closed-Loop Control Theory</h3>
            <p>State-space modeling · feedback stability · root locus · transfer functions · MATLAB/Simulink.</p>
            <p class="stack"><strong>Scope:</strong> mathematical verification of plant dynamics, observers, and motor/actuator controllers.</p></div>
        </div>
      </div>
    </section>

    <!-- VAULT -->
    <section class="section" id="vault">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">02 // Live Systems Vault</p>
          <span class="sec-index">PROOF.NOT_SLIDES — 03 DEPLOYED</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Deployed. Live. Clickable.</h2>
        <div style="display:grid;gap:16px;margin-top:28px">
          <article class="card vault-card rv">
            <a class="preview" href="https://npl-automation.pages.dev/" target="_blank" rel="noopener noreferrer" aria-label="Open live BOM schema engine">
              <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">npl-automation.pages.dev</span><span class="pv-open">↗</span></span>
              <span class="pv-screen">
                <span class="pv-row"><span class="pv-cell w40"></span><span class="pv-cell w25"></span><span class="pv-pill ok">VALID</span></span>
                <span class="pv-row"><span class="pv-cell w40"></span><span class="pv-cell w25"></span><span class="pv-pill ok">VALID</span></span>
                <span class="pv-row scan"><span class="pv-cell w40"></span><span class="pv-cell w25"></span><span class="pv-pill ok">VALID</span></span>
                <span class="pv-row"><span class="pv-cell w40"></span><span class="pv-cell w25"></span><span class="pv-pill ok">VALID</span></span>
                <span class="pv-foot"><span class="pv-badge">12,408 rows · 41ms</span></span>
              </span>
            </a>
            <div class="vault-body">
            <span class="tag live"><i></i>Live production system</span><span class="tag">&lt;50ms exec</span>
            <h3 style="margin-top:10px">Finished Goods &amp; BOM Schema Transformation Engine</h3>
            <p class="meta"><a href="https://npl-automation.pages.dev/">npl-automation.pages.dev</a> · Bommasandra facility</p>
            <ul class="tight">
              <li>Embedded on-site into high-throughput manufacturing ops to kill spreadsheet bottlenecks between production teams and ERP catalogs.</li>
              <li>Recursive client-side schema parsing on Cloudflare Pages — multi-day backlogs → automated pipeline in sub-50ms.</li>
              <li>Strict runtime types, 100% client-side privacy. Zero data leakage, zero cataloging drift.</li>
            </ul>
            <p class="stack"><strong>Stack:</strong> TypeScript · Cloudflare Pages · Pydantic schema principles · REST</p>
            <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://npl-automation.pages.dev/" target="_blank" rel="noopener noreferrer">Open live system ↗</a></p>
            </div>
          </article>
          <article class="card vault-card rv">
            <a class="preview" href="https://image-sequence-renamer.pages.dev/" target="_blank" rel="noopener noreferrer" aria-label="Open live asset ingestion engine">
              <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">image-sequence-renamer.pages.dev</span><span class="pv-open">↗</span></span>
              <span class="pv-screen">
                <span class="pv-tiles">
                  <span class="pv-tile"><b>001</b></span><span class="pv-tile"><b>002</b></span><span class="pv-tile"><b>003</b></span>
                  <span class="pv-tile"><b>004</b></span><span class="pv-tile"><b>005</b></span><span class="pv-tile"><b>006</b></span>
                </span>
                <span class="pv-progress"><span class="pv-fill"></span></span>
                <span class="pv-foot"><span class="pv-badge">248 files · renamed ✓</span></span>
              </span>
            </a>
            <div class="vault-body">
            <span class="tag live"><i></i>Live production utility</span><span class="tag">&gt;80% latency cut</span>
            <h3 style="margin-top:10px">Batch Asset Ingestion &amp; Normalization Engine</h3>
            <p class="meta"><a href="https://image-sequence-renamer.pages.dev/">image-sequence-renamer.pages.dev</a></p>
            <ul class="tight">
              <li>In-browser batch utility to normalize, sequence, and validate high-volume media assets for cataloging.</li>
              <li>Cut onboarding latency &gt;80% with zero server compute or cloud ingestion cost.</li>
            </ul>
            <p class="stack"><strong>Stack:</strong> JavaScript · HTML5 File API · Cloudflare Pages</p>
            <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://image-sequence-renamer.pages.dev/" target="_blank" rel="noopener noreferrer">Open live utility ↗</a></p>
            </div>
          </article>
          <article class="card vault-card rv">
            <a class="preview" href="https://kshitijsawarkar.github.io/Wakefit_Repair_Calculator/" target="_blank" rel="noopener noreferrer" aria-label="Open live repair cost calculator">
              <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">Wakefit_Repair_Calculator</span><span class="pv-open">↗</span></span>
              <span class="pv-screen">
                <span class="pv-display">₹ 2,450<span class="pv-caret"></span></span>
                <span class="pv-keys"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="hl"></span></span>
                <span class="pv-foot"><span class="pv-badge">deterministic · 0 drift</span></span>
              </span>
            </a>
            <div class="vault-body">
            <span class="tag live"><i></i>Live operational utility</span><span class="tag">margin guardrail</span>
            <h3 style="margin-top:10px">Deterministic Repair Cost Pricing Engine</h3>
            <p class="meta"><a href="https://kshitijsawarkar.github.io/Wakefit_Repair_Calculator/">Wakefit Repair Calculator</a></p>
            <ul class="tight">
              <li>Multi-parameter furniture repair logic compiled into a deterministic calculation engine.</li>
              <li>Standardized factory-floor estimates — killed margin erosion from human calculation drift.</li>
            </ul>
            <p class="stack"><strong>Stack:</strong> JavaScript · Responsive CSS · Deterministic pricing logic</p>
            <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://kshitijsawarkar.github.io/Wakefit_Repair_Calculator/" target="_blank" rel="noopener noreferrer">Open live utility ↗</a></p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- RESEARCH -->
    <section class="section" id="research">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">03 // Research &amp; Hardware Moat</p>
          <span class="sec-index">PEER-REVIEWED + BENCH-TESTED</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Research + rigs.</h2>
        <div class="grid-2" style="margin-top:28px">
          <div class="card rv">
            <span class="tag live"><i></i>IEEE Xplore · Doc 10627276</span>
            <h3 style="margin-top:10px">Automated Edge Vision &amp; Retail Checkout with Quantized YOLOv5</h3>
            <p class="meta">Lead author · Published March 2026</p>
            <p style="margin-top:12px">Custom YOLOv5 on ARM Raspberry Pi. INT8 post-training quantization via ONNX Runtime — balanced activation ranges, preserved &lt;1% mAP loss, sub-second inference, no discrete GPU.</p>
            <p style="margin-top:12px"><a class="btn btn-secondary btn-sm" href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener noreferrer">Verify on IEEE ↗</a></p>
          </div>
          <div class="card rv rv-d1">
            <span class="tag">ROS2 · HIL · CLOSED-LOOP</span>
            <h3 style="margin-top:10px">Mobile Robotics &amp; Embedded Systems</h3>
            <ul class="tight">
              <li><strong style="color:var(--ink)">HiWonder MentorPi M1 (ROS2):</strong> chassis assembly, battery subsystems, custom Pi 5 kernels; monocular vision + SLAM for indoor avoidance &amp; path planning.</li>
              <li><strong style="color:var(--ink)">Sensorless solar tracking:</strong> closed-loop tracking from PV output voltage itself — no fragile LDRs; servo logic seeks max power point.</li>
              <li><strong style="color:var(--ink)">HIL safety telemetry:</strong> Wokwi digital twins (Uno + MQ-2), interrupt-driven interlocks, audio/visual alarms.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- TRAJECTORY -->
    <section class="section" id="trajectory">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">04 // Trajectory &amp; Edge Assets</p>
          <span class="sec-index">LOG.2019 → PRESENT</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Where I've been deployed.</h2>
        <div class="grid-2" style="margin-top:24px">
          <div class="card rv"><h3>cardsfinders.com</h3><p class="meta">FOUNDER · JUL 2026 → PRESENT</p><p>Global edge platform on Cloudflare Pages + Workers. Edge DNS, mail routing, sub-second TTFB, zero server runtime cost. <a href="https://cardsfinders.com" target="_blank" rel="noopener noreferrer">Visit ↗</a></p></div>
          <div class="card rv rv-d1"><h3>myuselessweb.com</h3><p class="meta">CREATOR · JAN 2024 → PRESENT</p><p>Minimalist high-traffic discovery engine on Cloudflare edge — consistent &lt;50ms responses. <a href="https://myuselessweb.com" target="_blank" rel="noopener noreferrer">Visit ↗</a></p></div>
        </div>
        <div class="timeline">
          <div class="t-item rv"><p class="t-when">Aug 2026 → Present · Bengaluru</p><div class="card" style="margin-top:10px"><h3>Wakefit Innovations — Systems &amp; Automation Intern (PGET)</h3><p>Embedded in manufacturing + NPL ops; shipped client-side schema engines that cleared floor backlogs.</p></div></div>
          <div class="t-item rv"><p class="t-when">Aug 2025 → Present · Prayagraj</p><div class="card" style="margin-top:10px"><h3>MNNIT Allahabad — Graduate Teaching Assistant</h3><p>Control Systems + Instrumentation labs for 100+ undergrads. State feedback, root locus, HIL testbenches.</p></div></div>
          <div class="t-item rv"><p class="t-when">May 2023 → Jul 2023 · Remote</p><div class="card" style="margin-top:10px"><h3>AICTE (AWS) — Cloud &amp; MLOps Intern</h3><p>Serverless ETL (S3 triggers + Lambda, ~99.9% uptime); SageMaker endpoints.</p></div></div>
          <div class="t-item rv"><p class="t-when">Dec 2023 → Feb 2024 · Nagpur</p><div class="card" style="margin-top:10px"><h3>Sharon Innovations (RCOEM TBI) — IoT &amp; Embedded Intern</h3><p>ESP32/Arduino sensor nodes, ADC calibration, I2C/SPI/UART debugging.</p></div></div>
          <div class="t-item rv"><p class="t-when">Jun 2022 → Jul 2022 · Nagpur</p><div class="card" style="margin-top:10px"><h3>UCN Cable Network — Network &amp; Hardware Intern</h3><p>ODF config, managed switches/routers, SNR audits, fiber continuity.</p></div></div>
        </div>
        <div class="grid-2" style="margin-top:20px">
          <div class="card rv"><h3>M.Tech — Control &amp; Instrumentation</h3><p class="meta">MNNIT ALLAHABAD · 2025 → 2027</p></div>
          <div class="card rv rv-d1"><h3>B.Tech — Electronics &amp; Communication</h3><p class="meta">RCOEM NAGPUR · 2021 → 2024</p></div>
        </div>
      </div>
    </section>

    <!-- AGENTS -->
    <section class="section agents" id="agents">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow eyebrow-agent">05 // Agent Interface</p>
          <span class="sec-index">AGENT.READY — MCP · LLM · RAG</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Built for humans.<br /><span class="agent-grad">Grounded for agents.</span></h2>
        <p class="rv rv-d1" style="max-width:62ch">Every claim on this page is mirrored in deterministic machine-readable files — so AI assistants quote facts instead of hallucinating. Plug this site straight into your agent, RAG pipeline, or MCP host.</p>

        <div class="grid-2" style="margin-top:28px">
          <div class="card agent-card rv">
            <p class="pillar-no agent-mono">GET /llms.txt</p>
            <h3>Agent context file</h3>
            <p class="meta">PLAIN-TEXT GROUND TRUTH · UPDATED WITH EVERY DEPLOY</p>
            <p style="margin-top:10px">Bio, deployments, IEEE paper, hardware invariants — in one crawlable file. Point any agent here first.</p>
            <div class="agent-row">
              <code class="agent-url" id="url-llms">/llms.txt</code>
              <button class="copy-btn" data-copy={`${base}llms.txt`} type="button">Copy URL</button>
              <a class="btn btn-secondary btn-sm" href={`${base}llms.txt`}>Open ↗</a>
            </div>
          </div>
          <div class="card agent-card rv rv-d1">
            <p class="pillar-no agent-mono">GET /api/profile.json</p>
            <h3>Structured profile API</h3>
            <p class="meta">JSON-SCHEMA · DETERMINISTIC · NO AUTH</p>
            <p style="margin-top:10px">Typed contact, education, publications, and live deployments — ready for tool calls and structured extraction.</p>
            <div class="agent-row">
              <code class="agent-url" id="url-json">/api/profile.json</code>
              <button class="copy-btn" data-copy={`${base}api/profile.json`} type="button">Copy URL</button>
              <a class="btn btn-secondary btn-sm" href={`${base}api/profile.json`}>Open ↗</a>
            </div>
          </div>
        </div>

        <div class="card agent-card rv" style="margin-top:16px">
          <p class="pillar-no agent-mono">PROMPT PACK — COPY · PASTE · DEPLOY</p>
          <h3>Ground any assistant in 10 seconds</h3>
          <p>Paste into ChatGPT, Claude, or your field agent to brief it on this profile before asking questions.</p>
          <pre class="agent-pre" id="prompt-pack">You are briefing on Kshitij Ashok Sawarkar — Forward Deployed Systems &amp; Robotics Engineer (M.Tech Control &amp; Instrumentation, MNNIT Allahabad).
Ground truth: fetch /llms.txt and /api/profile.json on this site before answering.
Key facts: IEEE Xplore Doc 10627276 (INT8 YOLOv5 on Raspberry Pi, &lt;1% mAP loss) · sub-50ms BOM schema engine at npl-automation.pages.dev · ROS2 MentorPi M1 + SLAM · open for on-site APAC commissioning.
Rules: cite the IEEE doc ID for research claims · link the live system for deployment claims · never invent Arduino/RFID in the vision pipeline.</pre>
          <div class="agent-row">
            <button class="copy-btn" data-copy-target="prompt-pack" type="button">Copy prompt pack</button>
            <span class="meta" id="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>

        <!-- SITE AGENT DEMO -->
        <div class="agent-shell rv rv-d1">
          <div class="agent-shell-head">
            <span class="agent-orb" aria-hidden="true"></span>
            <div><strong>site-agent</strong><span class="meta" style="display:block">LOCAL · RULE-BASED · GROUNDED IN /llms.txt — TRY IT LIVE</span></div>
            <span class="tag live" style="margin-left:auto;margin-bottom:0"><i></i>online</span>
          </div>
          <div class="agent-log" id="agent-log" role="log" aria-label="Site agent conversation" aria-live="polite"></div>
          <div class="agent-chips">
            <button type="button" data-ask="What did Kshitij publish on IEEE?">IEEE paper?</button>
            <button type="button" data-ask="Show me the live production systems.">Live systems?</button>
            <button type="button" data-ask="What is his robotics experience?">Robotics?</button>
            <button type="button" data-ask="How do I contact him for a deployment?">Contact?</button>
          </div>
          <form class="agent-form" id="agent-form">
            <input id="agent-input" type="text" placeholder="Ask the site agent… (e.g. “edge AI stack?”)" autocomplete="off" maxlength="200" aria-label="Ask the site agent" />
            <button class="btn btn-primary btn-sm" type="submit">Send →</button>
          </form>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section" id="contact">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">06 // Direct Commissioning Inbound</p>
          <span class="sec-index">CH.OPEN — RESPONSE &lt;24H</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 24px">Establish the link.</h2>
        <div class="terminal rv rv-d1" role="region" aria-label="Contact terminal">
          <div class="term-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="meta" style="margin-left:8px">kshitij@field-ops:~</span></div>
          <div class="term-body">
            <div><span class="prompt">$</span> <span id="term-type"></span><span class="cursor" aria-hidden="true"></span></div>
            <div style="margin-top:14px">├─ email&nbsp;&nbsp;&nbsp;&nbsp;<a href="mailto:kshitijsawarkar333@gmail.com">kshitijsawarkar333@gmail.com</a></div>
            <div>├─ linkedin <a href="https://linkedin.com/in/kshitijas" target="_blank" rel="noopener noreferrer">linkedin.com/in/kshitijas</a></div>
            <div>├─ github&nbsp;&nbsp;<a href="https://github.com/KshitijSawarkar" target="_blank" rel="noopener noreferrer">github.com/KshitijSawarkar</a></div>
            <div>├─ base&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Bengaluru / Nagpur, India</div>
            <div>└─ agents&nbsp;&nbsp;&nbsp;[<a href={`${base}llms.txt`}>/llms.txt</a>] · [<a href={`${base}api/profile.json`}>/api/profile.json</a>]</div>
            <div style="margin-top:14px"><span class="prompt">$</span> status → <span style="color:var(--accent)">OPEN for on-site commissioning sprints · AMR rollouts · floor automation</span></div>
