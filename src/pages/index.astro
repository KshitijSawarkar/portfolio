---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout>
  <!-- HEADER -->
  <header class="site-header">
    <div class="wrap">
      <div class="header-row">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <a class="brand" href="#top" translate="no"><span class="sig">KS</span>kshitij.sawarkar <small>// forward-deployed systems &amp; AMR</small></a>
          <span class="telemetry"><span class="dot" aria-hidden="true"></span><span id="tele-text">SYS.ONLINE — Wakefit NPL Ops · MNNIT M.Tech</span></span>
        </div>
        <nav class="nav" aria-label="Primary">
          <a href="#competencies">01 Competencies</a>
          <a href="#vault">02 Deployments</a>
          <a href="#research">03 Research</a>
          <a href="#ai">04 AI &amp; RF</a>
          <a href="#trajectory">05 Experience</a>
          <a href="#agents">06 Agents</a>
          <a href="#contact">07 Contact</a>
          <button class="theme-btn" id="theme-btn" type="button" aria-pressed="false" aria-label="Switch to day mode" title="Toggle day / night"><span id="theme-icon" aria-hidden="true">☾</span></button>
          <span class="clock" id="clock" aria-hidden="true">--:--:-- IST</span>
        </nav>
      </div>
      <div class="machine-strip"><span><b>▸ AI GROUND TRUTH</b> GET <a href={`${base}llms.txt`}>/llms.txt</a> · GET <a href={`${base}api/profile.json`}>/api/profile.json</a></span><span style="margin-left:auto" id="build-tag">BUILD STABLE · EDGE-DEPLOYED</span></div>
    </div>
  </header>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-inner" id="ticker">
      <span><b>● FDE DEPLOYMENT</b> SUB-50MS PLANT-FLOOR SCHEMA ENGINE — WAKEFIT NPL OPS</span><span><b>● AMR ROBOTICS</b> ROS2 MENTORPI M1 · 2D LIDAR · SLAM</span><span><b>● UAV RF PIPELINE</b> SDR SPECTRAL SENSING · 2.4/5.8 GHZ INTERCEPTION</span><span><b>● IEEE 10627276</b> EDGE PERCEPTION · INT8 YOLOv5 ON ARM</span><span><b>● CONTROL SYSTEMS</b> M.TECH MNNIT ALLAHABAD · STATE-SPACE FEEDBACK</span><span><b>● FIELD READY</b> FORWARD DEPLOYED ENGINEERING &amp; ROBOTICS COMMISSIONING</span>
      <span><b>● FDE DEPLOYMENT</b> SUB-50MS PLANT-FLOOR SCHEMA ENGINE — WAKEFIT NPL OPS</span><span><b>● AMR ROBOTICS</b> ROS2 MENTORPI M1 · 2D LIDAR · SLAM</span><span><b>● UAV RF PIPELINE</b> SDR SPECTRAL SENSING · 2.4/5.8 GHZ INTERCEPTION</span><span><b>● IEEE 10627276</b> EDGE PERCEPTION · INT8 YOLOv5 ON ARM</span><span><b>● CONTROL SYSTEMS</b> M.TECH MNNIT ALLAHABAD · STATE-SPACE FEEDBACK</span><span><b>● FIELD READY</b> FORWARD DEPLOYED ENGINEERING &amp; ROBOTICS COMMISSIONING</span>
    </div>
  </div>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <canvas id="lidar" aria-hidden="true"></canvas>
      <div class="float-orb" style="width:340px;height:340px;left:-80px;top:10%;background:#123f2c"></div>
      <div class="float-orb" style="width:280px;height:280px;right:-60px;top:40%;background:#0e2a3f;animation-delay:-6s"></div>
      <div class="wrap" style="width:100%">
        <p class="eyebrow rv">Forward Deployed Engineering · Autonomous Mobile Robots (AMR) · Edge Perception · Plant Floor Automation</p>
        <h1 class="rv rv-d1" style="margin-top:14px"><span class="hero-name">Kshitij Ashok <span class="grad">Sawarkar</span></span><span class="role">Forward Deployed Systems &amp; Autonomous Robotics Engineer — M.Tech Control &amp; Instrumentation, MNNIT Allahabad</span></h1>
        <p class="type-line rv rv-d2" aria-live="polite"><span>&gt; </span><span id="typer"></span><span class="caret" aria-hidden="true"></span></p>
        <p class="location-focus rv rv-d2"><span class="dot" aria-hidden="true"></span><strong>⌖ Bengaluru / Hosur, India</strong><span> — available for on-site FDE deployment, plant-floor automation &amp; AMR commissioning sprints</span></p>
        <div class="manifesto rv rv-d2">
          Forward Deployed Systems and Autonomous Robotics Engineer with an M.Tech in Control and Instrumentation from MNNIT Allahabad and a B.Tech in Electronics and Communication Engineering from RCOEM Nagpur. Deploys at the physical edge where mechanical hardware, real-time embedded Linux, and plant-floor operations intersect. Proven record of commissioning autonomous mobile robots (ROS2 Humble, 2D LiDAR SLAM, monocular vision), publishing peer-reviewed edge-perception research in IEEE Xplore (Doc ID: 10627276), deploying SDR spectral intelligence pipelines for UAV RF classification, and engineering zero-downtime client-side manufacturing engines executing under 50ms across live industrial plant lines.
        </div>
        <div class="contact-strip rv rv-d3" aria-label="Direct contact and comms channels">
          <div class="contact-strip-header">
            <span class="contact-tele-dot" aria-hidden="true"></span>
            <span class="contact-strip-label">Direct Comms Uplink // Verified Channels</span>
            <span class="contact-strip-sub">Response &lt;24h · Available for field deployments</span>
          </div>
          <div class="contact-badges">
            <a class="contact-badge" href="mailto:kshitijsawarkar333@gmail.com" title="Send email to Kshitij Ashok Sawarkar">
              <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="badge-text">kshitijsawarkar333@gmail.com</span>
              <span class="badge-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="contact-badge" href="tel:+919823252972" title="Direct call or WhatsApp">
              <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span class="badge-text">+91-9823252972</span>
              <span class="badge-arrow" aria-hidden="true">↗</span>
            </a>
            <span class="contact-badge contact-badge-static" title="Primary operating location">
              <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              <span class="badge-text">Bengaluru / Hosur, India</span>
            </span>
            <a class="contact-badge" href="https://linkedin.com/in/kshitijas/" target="_blank" rel="noopener noreferrer" title="Open LinkedIn Profile">
              <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              <span class="badge-text">LinkedIn</span>
              <span class="badge-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="contact-badge" href="https://github.com/KshitijSawarkar" target="_blank" rel="noopener noreferrer" title="Open GitHub Profile">
              <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              <span class="badge-text">GitHub</span>
              <span class="badge-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="cta-row rv rv-d3">
          <a class="btn btn-primary" href="https://drive.google.com/file/d/1OSRXNmmUL0gwdElcF-1Ftl1Xcxfa-7rT/view?usp=sharing" target="_blank" rel="noopener noreferrer">Hardware Telemetry (MentorPi M1 AMR) ↗</a>
          <a class="btn btn-secondary" href="https://npl-automation.pages.dev/" target="_blank" rel="noopener noreferrer">Live Industrial FDE Engine (npl-automation) ↗</a>
          <a class="btn btn-secondary" href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener noreferrer">View IEEE Research (Doc ID: 10627276) ↗</a>
        </div>
        <div class="stats rv rv-d3">
          <div class="stat"><div class="num">ROS2</div><div class="lbl">Humble AMR stack</div></div>
          <div class="stat"><div class="num"><em>&lt;</em><span data-count="50">0</span>ms</div><div class="lbl">FDE schema latency</div></div>
          <div class="stat"><div class="num"><em>&lt;</em><span data-count="1">0</span>%</div><div class="lbl">mAP loss after INT8</div></div>
          <div class="stat"><div class="num">10627276</div><div class="lbl">IEEE Xplore doc ID</div></div>
        </div>
        <div class="chips rv rv-d3">
          <span class="chip">ROS2 (nodes &amp; lifecycle)</span><span class="chip">AMR 2D LiDAR SLAM</span><span class="chip">Forward Deployed Engineering</span><span class="chip">Embedded Linux / Pi 5</span><span class="chip">YOLOv5 INT8 Quantization</span><span class="chip">SDR / RF Spectral Sensing</span><span class="chip">CAN · UART · SPI · I2C</span><span class="chip">Plant-Floor Automation</span><span class="chip">HIL Testing &amp; State-Space Control</span>
        </div>
      </div>
    </section>

    <!-- COMPETENCIES (PILLARS) -->
    <section class="section" id="competencies">
      <canvas class="bg-canvas" id="fx-pillars" aria-hidden="true"></canvas>
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">01 // Forward Deployed &amp; Robotics Competencies</p>
          <span class="sec-index">SYS.COMPETENCIES — 04 CORE DOMAINS</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Deterministic foundations from silicon to factory floor.</h2>
        <p class="rv rv-d1" style="max-width:64ch">Robust engineering stacks built to operate where physical robotics hardware, real-time embedded runtimes, control theory, and industrial operations collide.</p>
        <div class="grid-2" style="margin-top:28px">
          <div class="card rv">
            <p class="pillar-no">DOMAIN 01</p>
            <h3>Autonomous Robotics &amp; Embedded Motion</h3>
            <p>ROS2 (composition nodes, lifecycle management, pub/sub, tf2), Embedded Linux, Microcontrollers (Raspberry Pi 5, Arduino), Serial Protocols (CAN bus, UART, SPI, I2C), Sensor Synchronization (2D LiDAR, Monocular Vision, IMU, wheel odometry), Hardware-in-the-Loop (HIL) testing.</p>
            <p class="stack"><strong>FDE &amp; Robotics Scope:</strong> Site acceptance testing (SAT), floor-map calibration, obstacle avoidance triage, trajectory planning, motor actuation loops, and deterministic sensor-to-middleware integration.</p>
          </div>
          <div class="card rv rv-d1">
            <p class="pillar-no">DOMAIN 02</p>
            <h3>Edge Perception &amp; Embedded Computer Vision</h3>
            <p>Real-Time Computer Vision (YOLOv5, OpenCV), Model Quantization (INT8 Post-Training Quantization), ARM Edge Compute Optimization, Spectral Feature Extraction, Machine Learning (TensorFlow, Keras, Scikit-Learn).</p>
            <p class="stack"><strong>FDE &amp; Robotics Scope:</strong> Sub-second multi-class edge detection on thermal-bounded ARM SBCs with &lt;1% mAP degradation, local spatial orienting, visual marker tracking, zero cloud round-trip latency, full offline factory readiness.</p>
          </div>
          <div class="card rv">
            <p class="pillar-no">DOMAIN 03</p>
            <h3>Autonomous Aerial Systems &amp; RF Telemetry</h3>
            <p>Software-Defined Radio (SDR), RF Signal Classification, Spectrogram Generation, I/Q Signal Parsing, Fast Fourier Transforms (FFT), Commercial UAV Flight Controller Telemetry Interception across 2.4 GHz &amp; 5.8 GHz ISM bands.</p>
            <p class="stack"><strong>FDE &amp; Robotics Scope:</strong> Field spectral sensing, drone flight controller link isolation against ambient industrial RF noise, non-cooperative aerial threat classification for perimeter robotics security.</p>
          </div>
          <div class="card rv rv-d1">
            <p class="pillar-no">DOMAIN 04</p>
            <h3>Forward Deployed Systems &amp; Industrial Runtimes</h3>
            <p>Deterministic Parsing Algorithms, Client-Side Runtime Optimization, Cloudflare Pages, Plant-Floor ERP/MES Schema Guardrails, AWS (EC2, Lambda, S3, SageMaker), Docker, Shell Scripting, Git.</p>
            <p class="stack"><strong>FDE &amp; Robotics Scope:</strong> Eliminating multi-day plant floor reconciliation bottlenecks, zero-compute client engines, air-gapped field readiness, authoring formal operational guardrails (AGENTS.md) preventing catastrophic line halts.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- VAULT -->
    <section class="section" id="vault">
      <canvas class="bg-canvas" id="fx-vault" aria-hidden="true"></canvas>
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">02 // Forward Deployed Systems &amp; Robotics Deployments</p>
          <span class="sec-index">MISSION.CONTROL — 06 VERIFIED FIELD BUILDS · AUTO-CYCLING</span>
        </div>
        <h2 class="rv rv-d1" style="margin:12px 0 6px">Field-commissioned. Bench-tested. Clickable.</h2>
        <p class="rv rv-d1" style="max-width:64ch">Interactive mission console showcasing live autonomous mobile robots, plant-floor manufacturing engines, SDR spectral pipelines, and closed-loop control systems.</p>
        
        <div class="dash rv rv-d1" id="dash">
          <div class="dash-top">
            <span class="dash-count"><b id="dash-cur">01</b><span> / 06</span></span>
            <span class="dash-status"><span class="dot" aria-hidden="true"></span><span id="dash-name">MentorPi M1 AMR (ROS2)</span></span>
            <div class="dash-btns">
              <button class="dash-arrow" id="dash-prev" type="button" aria-label="Previous project">‹</button>
              <button class="dash-arrow" id="dash-next" type="button" aria-label="Next project">›</button>
            </div>
          </div>
          <div class="dash-view" id="dash-view" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Flagship projects dashboard. Use left and right arrow keys to navigate.">
            <div class="dash-track" id="dash-track">
              <!-- Slide 1: MentorPi M1 Robot (AMR / ROS2) -->
              <article class="dash-slide" aria-label="1 of 6: MentorPi M1 Autonomous Robot">
                <a class="preview dash-media" href="https://drive.google.com/file/d/1OSRXNmmUL0gwdElcF-1Ftl1Xcxfa-7rT/view?usp=sharing" target="_blank" rel="noopener noreferrer" aria-label="Open MentorPi Chassis Video" tabindex="-1">
                  <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">mentorpi-m1.ros2</span><span class="pv-open">↗</span></span>
                  <span class="pv-shot-wrap"><img class="pv-shot pv-contain" src={`${base}previews/mentorpi.png`} alt="HiWonder MentorPi M1 Autonomous Mobile Robot" loading="lazy" /><span class="pv-live"><i></i>ROBOTICS BENCH</span></span>
                </a>
                <div class="dash-info">
                  <span class="tag live"><i></i>ROS2 on Pi 5</span><span class="tag">AMR Commissioning</span>
                  <h3>HiWonder MentorPi M1 Autonomous Robotics Platform</h3>
                  <p class="meta">Raspberry Pi 5 · ROS2 Navigation &amp; Vision Stack · 2D LiDAR SLAM</p>
                  <ul class="tight">
                    <li>Programmed and tuned an autonomous mobile robot (AMR) unit powered by a Raspberry Pi 5 single-board computer running Robot Operating System 2 (ROS2 Humble).</li>
                    <li>Configured modular ROS2 publisher/subscriber nodes for real-time motor actuation, PWM driver loops, and telemetry streaming on embedded Linux.</li>
                    <li>Interfaced onboard monocular camera feeds with OpenCV pipelines for visual marker tracking, target acquisition, and spatial orientation.</li>
                    <li>Bench-tested sensor synchronization across 2D LiDAR, IMU, and motor encoders for indoor SLAM map generation and obstacle triage.</li>
                  </ul>
                  <p class="stack"><strong>Stack:</strong> Raspberry Pi 5 · ROS2 Humble · 2D LiDAR · Computer Vision · Robotics Telemetry · SLAM</p>
                  <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://drive.google.com/file/d/1OSRXNmmUL0gwdElcF-1Ftl1Xcxfa-7rT/view?usp=sharing" target="_blank" rel="noopener noreferrer">Inspect chassis &amp; telemetry ↗</a></p>
                </div>
              </article>

              <!-- Slide 2: BOM Schema Engine (Forward Deployed Engineering) -->
              <article class="dash-slide" aria-label="2 of 6: BOM Schema Engine">
                <a class="preview dash-media" href="https://npl-automation.pages.dev/" target="_blank" rel="noopener noreferrer" aria-label="Open live BOM schema engine" tabindex="-1">
                  <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">npl-automation.pages.dev</span><span class="pv-open">↗</span></span>
                  <span class="pv-shot-wrap"><img class="pv-shot" src={`${base}previews/bom.png`} alt="Screenshot of the NPL Automation Engine" loading="lazy" /><span class="pv-live"><i></i>LIVE PRODUCTION FDE</span></span>
                </a>
                <div class="dash-info">
                  <span class="tag live"><i></i>Forward Deployed Engine</span><span class="tag">&lt;50ms exec</span>
                  <h3>Manufacturing Schema &amp; BOM Automation Engine (NPL Automation)</h3>
                  <p class="meta"><a href="https://npl-automation.pages.dev/" tabindex="-1">npl-automation.pages.dev</a> · Wakefit Innovations Ltd. (Bengaluru / Hosur)</p>
                  <ul class="tight">
                    <li>Forward-deployed production client-side application on Cloudflare Pages, automating multi-tier Finished Goods (FG) code generation and NPL parameter trees across dynamic seater variants and colorways.</li>
                    <li>Eliminated multi-day manual ERP spreadsheet reconciliation bottlenecks via recursive parsing algorithms, compressing BOM derivation from 72+ operational hours into deterministic sub-minute runs with sub-50ms latency.</li>
                    <li>Authored formal operational constraints (<code>AGENTS.md</code>) and deterministic validation guardrails preventing parameter collisions and upstream ERP ingestion errors across active plant lines.</li>
                    <li>Structured zero-compute infrastructure running 100% client-side with full data isolation and complete offline plant-floor readiness.</li>
                  </ul>
                  <p class="stack"><strong>Stack:</strong> Forward Deployed Engineering · JavaScript · Cloudflare Pages · Deterministic Parsing · AGENTS.md guardrails</p>
                  <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://npl-automation.pages.dev/" target="_blank" rel="noopener noreferrer">Open live FDE engine ↗</a></p>
                </div>
              </article>

              <!-- Slide 3: Drone RF Classification (Aerial Robotics & SDR) -->
              <article class="dash-slide" aria-label="3 of 6: Drone RF Classification">
                <a class="preview dash-media" href="https://docs.google.com/presentation/d/1IMEy7h-iVUmmVrr2GoM_qS5AJWuqM7LC51hbWQ7Y5Rg/edit?usp=sharing" target="_blank" rel="noopener noreferrer" aria-label="Open Drone RF Presentation" tabindex="-1">
                  <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">rf-telemetry-pipeline</span><span class="pv-open">↗</span></span>
                  <span class="pv-shot-wrap"><img class="pv-shot" src={`${base}previews/drone-rf.jpg`} alt="Real-Time Drone Detection and RF Signal Classification Dashboard" loading="lazy" /><span class="pv-live"><i></i>TELEMETRY PIPELINE</span></span>
                </a>
                <div class="dash-info">
                  <span class="tag live"><i></i>SDR Telemetry</span><span class="tag">2.4 / 5.8 GHz</span>
                  <h3>Real-Time Drone Detection &amp; RF Signal Classification</h3>
                  <p class="meta">Automated Edge Spectral Sensing Pipeline · Autonomous Aerial Defense</p>
                  <ul class="tight">
                    <li>Built an automated edge spectral sensing pipeline intercepting communication bursts between commercial UAV flight controllers and Ground Control Stations (GCS) across 2.4 GHz and 5.8 GHz ISM bands.</li>
                    <li>Configured Software-Defined Radio (SDR) hardware to stream raw I/Q signal data, applying Fast Fourier Transforms (FFT) and spectrogram processing to isolate low-power transmission spikes against ambient radio noise.</li>
                    <li>Trained lightweight neural classification models to differentiate drone telemetry from Wi-Fi/Bluetooth interference with sub-second classification latency.</li>
                  </ul>
                  <p class="stack"><strong>Stack:</strong> Python · Software-Defined Radio (SDR) · RF Signal Processing · Machine Learning · UAV Telemetry</p>
                  <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://docs.google.com/presentation/d/1IMEy7h-iVUmmVrr2GoM_qS5AJWuqM7LC51hbWQ7Y5Rg/edit?usp=sharing" target="_blank" rel="noopener noreferrer">View technical presentation ↗</a></p>
                </div>
              </article>

              <!-- Slide 4: Smart Shopping Cart (IEEE - Robotics Edge Perception) -->
              <article class="dash-slide" aria-label="4 of 6: Smart Shopping Cart">
                <a class="preview dash-media" href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener noreferrer" aria-label="Open IEEE Xplore publication" tabindex="-1">
                  <span class="pv-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="pv-url">ieee.org/document/10627276</span><span class="pv-open">↗</span></span>
                  <span class="pv-shot-wrap"><img class="pv-shot" src={`${base}previews/repair.png`} alt="Smart Shopping Cart Edge Vision Architecture" loading="lazy" /><span class="pv-live"><i></i>IEEE PEER-REVIEWED</span></span>
                </a>
                <div class="dash-info">
                  <span class="tag live"><i></i>IEEE Xplore Doc 10627276</span><span class="tag">&lt;1% mAP loss</span>
                  <h3>Smart Shopping Cart: Real-Time Edge Object Detection</h3>
                  <p class="meta">Lead author · Published in IEEE Xplore · Edge Perception for Autonomous Carts</p>
                  <ul class="tight">
                    <li>Curated a custom retail dataset and fine-tuned YOLOv5 models for multi-class edge detection running directly on ARM-constrained Raspberry Pi hardware.</li>
                    <li>Implemented INT8 model parameter quantization and cache optimization to balance thermal throttling limits against frames-per-second (FPS) throughput.</li>
                    <li>Designed an OpenCV pipeline executing local billing and vision logic with zero server dependencies, guaranteeing full offline operational readiness under thermal boundaries.</li>
                  </ul>
                  <p class="stack"><strong>Stack:</strong> Raspberry Pi · YOLOv5 · OpenCV · Python · INT8 Quantization · Edge Perception</p>
                  <p style="margin-top:14px"><a class="btn btn-primary btn-sm" href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener noreferrer">Verify on IEEE Xplore ↗</a></p>
                </div>
              </article>

