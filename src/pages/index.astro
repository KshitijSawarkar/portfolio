  <footer class="site-footer">
    <div class="wrap" style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <span>© 2026 KSHITIJ SAWARKAR · FDE OPS CONSOLE v3.0 · AGENT-NATIVE</span>
      <span>BUILT WITH ASTRO · <a href={`${base}llms.txt`}>llms.txt</a> · <a href={`${base}api/profile.json`}>profile.json</a></span>
    </div>
  </footer>

  <script>
    // 1 — clock (IST)
    const clockEl = document.getElementById('clock');
    function tickClock() {
      try {
        const t = new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour12: false });
        if (clockEl) clockEl.textContent = t + ' IST';
      } catch {}
    }
    tickClock(); setInterval(tickClock, 1000);

    // 2 — hero typer
    const phrases = [
      'ros2 bringup… AMR localized. map calibrated.',
      'INT8 quantized YOLOv5… inferring on edge, no cloud.',
      'schema engine validated 12,408 rows in 41ms.',
      'closed-loop stable. poles in LHP. commissioning GO.'
    ];
    const typer = document.getElementById('typer');
    let pi = 0, ci = 0, del = false;
    function typeLoop() {
      if (!typer) return;
      const p = phrases[pi];
      typer.textContent = p.slice(0, ci);
      if (!del) { ci++; if (ci > p.length + 14) del = true; }
      else { ci -= 2; if (ci <= 0) { ci = 0; del = false; pi = (pi + 1) % phrases.length; } }
      setTimeout(typeLoop, del ? 28 : 52);
    }
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) typeLoop(); else if (typer) typer.textContent = phrases[0];

    // 3 — terminal typer
    const termEl = document.getElementById('term-type');
    const termMsg = 'uplink --establish --field commissioning';
    let ti = 0;
    function termLoop() {
      if (!termEl) return;
      termEl.textContent = termMsg.slice(0, ti++);
      if (ti <= termMsg.length + 30) setTimeout(termLoop, ti <= termMsg.length ? 55 : 120);
    }
    if (!reduceMotion) { const io0 = new IntersectionObserver((e) => { if (e[0].isIntersecting) { termLoop(); io0.disconnect(); } }, { threshold: 0.4 }); const term = document.querySelector('.terminal'); if (term) io0.observe(term); }
    else if (termEl) termEl.textContent = termMsg;

    // 4 — scroll reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // 5 — animated counters
    const cio = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const el = en.target; cio.unobserve(el);
        const target = parseInt(el.dataset.count || '0', 10);
        if (reduceMotion) { el.textContent = String(target); return; }
        const t0 = performance.now(), dur = 1200;
        (function step(t) {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(step);
        })(t0);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

    // 6 — card spotlight follows cursor
    document.querySelectorAll('.card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
        card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
      });
    });

    // 7 — lidar radar canvas
    (function () {
      const cv = document.getElementById('lidar');
      if (!cv || reduceMotion) return;
      const ctx = cv.getContext('2d');
      let w, h, t = 0, pts = [];
      function size() {
        const r = cv.parentElement.getBoundingClientRect();
        w = cv.width = r.width; h = cv.height = r.height;
        pts = Array.from({ length: 70 }, () => ({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.8 + 0.4, s: Math.random() * 0.4 + 0.1 }));
      }
      size(); window.addEventListener('resize', size);
      const cx = () => w * 0.78, cy = () => h * 0.42;
      (function draw() {
        t += 0.012;
        ctx.clearRect(0, 0, w, h);
        // dots drift
        ctx.fillStyle = 'rgba(148,184,255,0.35)';
        pts.forEach((p) => { p.y -= p.s; if (p.y < 0) p.y = h; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 7); ctx.fill(); });
        // radar rings
        const R = Math.min(w, h) * 0.32;
        for (let i = 1; i <= 3; i++) {
          ctx.beginPath(); ctx.arc(cx(), cy(), (R / 3) * i, 0, 7);
          ctx.strokeStyle = 'rgba(61,255,143,0.16)'; ctx.lineWidth = 1; ctx.stroke();
        }
        // sweep
        ctx.save();
        ctx.translate(cx(), cy()); ctx.rotate(t);
        const g = ctx.createLinearGradient(0, 0, R, 0);
        g.addColorStop(0, 'rgba(61,255,143,0.5)'); g.addColorStop(1, 'rgba(61,255,143,0)');
        ctx.strokeStyle = g; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(R, 0); ctx.stroke();
        ctx.restore();
        // blips
        const blips = [[0.5, 1.2], [1.9, 2.6], [3.4, 0.6], [4.4, 2.0]];
        blips.forEach(([a, rr], i) => {
          const d = ((t * 1.2 + a) % (Math.PI * 2));
          const alpha = Math.max(0, 1 - d / 4);
          const bx = cx() + Math.cos(a) * (R / 3) * rr * 0.55, by = cy() + Math.sin(a) * (R / 3) * rr * 0.55;
          ctx.beginPath(); ctx.arc(bx, by, 3, 0, 7);
          ctx.fillStyle = `rgba(65,230,255,${(alpha * 0.9).toFixed(2)})`;
          ctx.shadowColor = '#41e6ff'; ctx.shadowBlur = 12 * alpha; ctx.fill(); ctx.shadowBlur = 0;
        });
        requestAnimationFrame(draw);
      })();
    })();

    // 8 — rotating telemetry line
    (function () {
      const el = document.getElementById('tele-text');
      if (!el || reduceMotion) return;
      const msgs = [
        'SYS.ONLINE — Wakefit NPL Ops · MNNIT M.Tech',
        'AMR_01 LOCALIZED · covariance nominal',
        'EDGE INFER 212ms · INT8 · no cloud',
        'SCHEMA ENGINE 41ms · 0 leaks · 0 drift'
      ];
      let i = 0;
      setInterval(() => { i = (i + 1) % msgs.length; el.textContent = msgs[i]; }, 3200);
    })();

    // 9 — copy buttons (agent URLs + prompt pack)
    (function () {
      const status = document.getElementById('copy-status');
      async function copyText(text, btn) {
        let ok = false;
        try { await navigator.clipboard.writeText(text); ok = true; }
        catch {
          const ta = document.createElement('textarea');
          ta.value = text; document.body.appendChild(ta); ta.select();
          try { ok = document.execCommand('copy'); } catch {}
          ta.remove();
        }
        if (btn) {
          const orig = btn.textContent;
          btn.textContent = ok ? 'Copied ✓' : 'Copy failed';
          btn.classList.toggle('ok', ok);
          setTimeout(() => { btn.textContent = orig; btn.classList.remove('ok'); }, 1800);
        }
        if (status) status.textContent = ok ? '✓ copied to clipboard' : '';
        return ok;
      }
      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rel = btn.getAttribute('data-copy') || '';
          copyText(new URL(rel, window.location.href).href, btn);
        });
      });
      document.querySelectorAll('[data-copy-target]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = document.getElementById(btn.getAttribute('data-copy-target') || '');
          if (src) copyText(src.innerText, btn);
        });
      });
    })();

    // 10 — site agent (local rule-based demo, grounded in page facts)
    (function () {
      const log = document.getElementById('agent-log');
      const form = document.getElementById('agent-form');
      const input = document.getElementById('agent-input');
      if (!log || !form || !input) return;
      const KB = [
        { k: ['ieee', 'paper', 'publish', 'research', 'yolo', 'quantiz', 'edge vision', 'retail'], a: 'Lead-author <b>IEEE Xplore Doc 10627276</b> (Mar 2026): quantized YOLOv5 on Raspberry Pi via ONNX Runtime INT8 — &lt;1% mAP loss, sub-second inference, no discrete GPU. <a href="https://ieeexplore.ieee.org/document/10627276" target="_blank" rel="noopener">Verify ↗</a>' },
        { k: ['live', 'production', 'system', 'deploy', 'vault', 'project', 'bom', 'schema', 'npl'], a: 'Three live systems: <b>BOM schema engine</b> (&lt;50ms, npl-automation.pages.dev) · <b>asset ingestion engine</b> (&gt;80% faster) · <b>repair pricing engine</b> (margin guardrail). Scroll to <b>02 // Vault</b> — every one is clickable.' },
        { k: ['robot', 'ros', 'slam', 'amr', 'mentorpi', 'embedded', 'hardware', 'solar', 'hil'], a: 'Robotics: <b>HiWonder MentorPi M1</b> on ROS2 + Pi 5 (SLAM, monocular vision) · sensorless solar tracking (PV-voltage sensing, no LDRs) · HIL twins with interrupt-driven safety interlocks.' },
        { k: ['contact', 'email', 'hire', 'commission', 'deploy him', 'reach', 'phone', 'linkedin'], a: 'Open for on-site APAC sprints → <b>kshitijsawarkar333@gmail.com</b> · <a href="https://linkedin.com/in/kshitijas" target="_blank" rel="noopener">LinkedIn</a> · response &lt;24h. Jump to <b>06 // Contact</b> to establish the link.' },
        { k: ['stack', 'tech', 'skill', 'typescript', 'cloudflare', 'matlab'], a: 'Core stack: <b>ROS2 · YOLOv5 INT8 · ONNX · TypeScript · Cloudflare edge · FastAPI · MATLAB/Simulink · ESP32/CAN/I2C</b>. Four pillars in <b>01 // Systems</b>.' },
        { k: ['educat', 'mtech', 'mnnit', 'degree', 'college', 'btech', 'study'], a: '<b>M.Tech Control &amp; Instrumentation, MNNIT Allahabad (2025–27)</b> + Graduate TA for 100+ students · B.Tech ECE, RCOEM Nagpur (2021–24).' },
        { k: ['wakefit', 'work', 'job', 'intern', 'experience', 'trajectory'], a: 'Now: <b>Wakefit Systems &amp; Automation Intern</b> (NPL ops, Bengaluru) + MNNIT TA. Previously: AICTE/AWS MLOps, Sharon IoT, UCN networks. Full log in <b>04 // Trajectory</b>.' },
        { k: ['agent', 'llm', 'mcp', 'rag', 'prompt', 'api', 'json', 'ground'], a: 'This site is agent-native: <b>GET /llms.txt</b> for context, <b>GET /api/profile.json</b> for typed data, plus the copy-paste <b>prompt pack</b> above. Facts only — no hallucination.' },
        { k: ['who', 'about', 'kshitij', 'summary', 'introduce'], a: '<b>Kshitij Ashok Sawarkar</b> — Forward Deployed Systems &amp; Robotics Engineer. Floor automation that survives contact with reality: sub-50ms engines, INT8 edge vision, ROS2 commissioning.' },
        { k: ['hi', 'hello', 'hey', 'namaste'], a: 'Uplink established. Ask about the <b>IEEE paper</b>, <b>live systems</b>, <b>robotics</b>, or <b>contact</b> — or use the quick chips above.' }
      ];
      const FALLBACK = 'Grounded answer unavailable for that query — I only answer from <b>/llms.txt</b>. Try: <b>IEEE paper?</b> · <b>live systems?</b> · <b>robotics?</b> · <b>contact?</b>';
      function addMsg(html, who) {
        const d = document.createElement('div');
        d.className = 'agent-msg ' + who;
        d.innerHTML = html;
        log.appendChild(d);
        log.scrollTop = log.scrollHeight;
        return d;
      }
      function answer(q) {
        const s = q.toLowerCase();
        for (const item of KB) if (item.k.some((k) => s.includes(k))) return item.a;
        return FALLBACK;
      }
      let greeted = false;
      function greet() {
        if (greeted) return; greeted = true;
        const hello = addMsg('Link established. I answer only from this site\u2019s ground truth (<b>/llms.txt</b> + <b>/api/profile.json</b>). What do you need?', 'bot');
        if (reduceMotion) return;
      }
      const gio = new IntersectionObserver((e) => { if (e[0].isIntersecting) { greet(); gio.disconnect(); } }, { threshold: 0.3 });
      gio.observe(log);
      function ask(q) {
        const query = q.trim();
        if (!query) return;
        greet();
        addMsg(query.replace(/</g, '&lt;'), 'user');
        input.value = '';
        if (reduceMotion) { addMsg(answer(query), 'bot'); return; }
        const t = document.createElement('div');
        t.className = 'agent-msg bot typing';
        t.innerHTML = '<i></i><i></i><i></i>';
        log.appendChild(t);
        log.scrollTop = log.scrollHeight;
        setTimeout(() => { t.remove(); addMsg(answer(query), 'bot'); }, 650 + Math.random() * 500);
      }
      form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
      document.querySelectorAll('[data-ask]').forEach((b) => b.addEventListener('click', () => ask(b.getAttribute('data-ask') || '')));
    })();
  </script>
