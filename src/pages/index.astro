    <div class="wrap">
      <div class="header-row">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <a class="brand" href="#top" translate="no">kshitij.sawarkar <small>// forward-deployed</small></a>
          <span class="telemetry"><span class="dot" aria-hidden="true"></span><span>Active: Manufacturing Systems Automation @ Wakefit | M.Tech Control &amp; Instrumentation @ MNNIT Allahabad</span></span>
        </div>
        <nav class="nav" aria-label="Primary">
