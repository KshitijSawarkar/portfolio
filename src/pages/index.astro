        <div class="cta-row rv">
          <a class="btn btn-primary" href="mailto:kshitijsawarkar333@gmail.com">Email me →</a>
          <a class="btn btn-secondary" href="https://linkedin.com/in/kshitijas" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
